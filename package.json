{
  "name": "sd-project",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm run build:server && node --watch dist/server/main.js",
    "dev:api": "pnpm run build:server && node --watch dist/server/main.js",
    "build": "pnpm run build:server && pnpm run build:web",
    "start": "node dist/server/main.js",
    "demo": "pnpm run build && node scripts/demo/start-demo.mjs",
    "demo:seed": "pnpm run build:server && node scripts/demo/start-demo.mjs --seed-only",
    "init-admin": "pnpm run build:server && node scripts/init-admin.mjs",
    "test": "pnpm run build:server && pnpm run test:unit",
    "check": "pnpm run check:field-independence && pnpm run build && pnpm run check:no-tax && pnpm run check:independent-input && pnpm run test:unit && pnpm run check:database-boundary && pnpm run check:architecture && pnpm run check:guides",
    "check:ui": "node scripts/check-native-ui.mjs",
    "check:field-independence": "node scripts/check-field-independence.mjs",
    "check:ui:strict": "node scripts/check-native-ui.mjs --strict",
    "backup": "pnpm run build:server && node scripts/backup.mjs",
    "test:performance": "pnpm run build:server && node --test tests/performance/*.bench.mjs",
    "test:browser": "pnpm run build && node tests/run-browser-suites.mjs",
    "package:win": "node scripts/release/build-and-package.mjs production",
    "package:win:demo": "node scripts/release/build-and-package.mjs demo",
    "test:package:demo": "node scripts/release/verify-demo-package.mjs",
    "test:browser:governance": "node scripts/test-legacy-browser.mjs --governance",
    "verify:release": "node scripts/release/build-and-package.mjs both --full",
    "report:delivery": "node scripts/release/write-delivery-report.mjs",
    "check:database-boundary": "node scripts/check-database-boundary.mjs",
    "check:schema": "python3 -B docs/architecture/schema113_database_acceptance.py && python3 -B docs/architecture/schema113_export_dictionary.py && python3 -B docs/architecture/schema113_structure_audit.py",
    "test:package": "node scripts/release/verify-package.mjs",
    "check:no-tax": "node scripts/check-no-tax.mjs",
    "check:independent-input": "node scripts/check-independent-input.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:server": "node scripts/build-server.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:guides": "node scripts/check-guides.mjs && node scripts/check-production-guides.mjs",
    "training:new": "pnpm run build && node scripts/training/instance.mjs start-new",
    "training:list": "node scripts/training/instance.mjs list",
    "build:web:legacy": "vue-tsc --noEmit && vite build",
    "test:browser:legacy": "node scripts/test-legacy-browser.mjs",
    "test:unit": "node scripts/check-native-ui.mjs --strict && node --test tests/api/*.test.mjs tests/domain/*.test.mjs tests/excel/*.test.mjs tests/ui/*.test.mjs",
    "release": "node scripts/release/build-and-package.mjs both"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/node": "^24.0.0",
    "@types/sortablejs": "1.15.9",
    "@types/tabulator-tables": "6.3.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-sfc": "^3.5.41",
    "element-plus": "^2.14.7",
    "esbuild": "0.28.2",
    "playwright": "^1.58.0",
    "sass": "1.93.2",
    "sortablejs": "1.15.7",
    "tabulator-tables": "6.7.1",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "~8.2.4",
    "vue": "^3.5.0",
    "vue-router": "4.6.4",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "10.34.5"
  },
  "packageManager": "pnpm@10.34.5"
}
