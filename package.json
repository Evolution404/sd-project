{
  "name": "sd-project",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 & node --watch server/server.mjs",
    "dev:api": "node --watch server/server.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node server/server.mjs",
    "init-admin": "node scripts/init-admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "backup": "node scripts/backup.mjs",
    "test:browser": "npm run build && node tests/browser.mjs && node tests/browser-audit.mjs && node tests/browser-lan-smoke.mjs"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "vite": "^7.3.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "playwright": "^1.58.0"
  }
}
